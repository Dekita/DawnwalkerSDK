# --- Build artifacts / caches (regenerated by UBT, not part of the SDK) ---
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# --- IDE / toolchain junk ---
.vs/
.vsconfig
*.opensdf
*.sdf
*.sln
*.suo
*.VC.db
*.VC.opendb
*.xcodeproj/
*.xcworkspace/
.idea/
*.iws
.vscode/
*.code-workspace

# --- Misc build byproducts that can end up outside Intermediate/ ---
*.log
*.pdb
*.ipdb
*.iobj
*.tlog
*.obj

# --- Content is not part of this SDK: the generator reconstructs code
#     (Source/) only, not assets. Keep the repo focused on that, except for
#     a small hand-authored example mod showing the SDK actually resolves
#     classes correctly in-editor (Content/Mods/ExampleUI - a Blueprint
#     widget + actor, not extracted from the game). ---
Content/*
!Content/Mods/
Content/Mods/*
!Content/Mods/ExampleUI/

# --- Locally-installed tooling that isn't part of the reconstructed SDK
#     itself (not referenced anywhere in Dawnwalker.uproject) ---
Plugins/NexusModsAuthorTools-v1.0-UE-5.5/

# --- OS junk ---
Thumbs.db
.DS_Store
